# Copy this file to .env and fill in your own values. .env is ignored by git and must never be committed.
# In CI the same names are provided as repository variables and secrets (see README, "CI pipeline").

# Base URL of the API Gateway stage of YOUR deployed backend (no trailing slash).
API_BASE_URL=https://<api-id>.execute-api.<region>.amazonaws.com/develop

# Base URL of YOUR deployed frontend (CloudFront distribution).
UI_BASE_URL=https://<distribution-id>.cloudfront.net

# Optional: a table to book. When empty, a table for 6 guests is discovered through the API.
# TABLE_ID=

# Optional: an existing waiter of the tested location. Without it the scenarios tagged "Waiter" are skipped.
# WAITER_EMAIL=waiter@example.com
# WAITER_PASSWORD=

# Optional: use an installed browser instead of the bundled Chromium ("chrome" or "msedge"); set HEADED=1 to watch the run.
# BROWSER_CHANNEL=chrome
# HEADED=1

# Optional: where traces, screenshots and videos of failed UI tests are written (default: ./artifacts).
# ARTIFACTS_DIR=

# Optional: Report Portal (see README). The adapter is disabled unless ReportPortal_Enabled=true.
# ReportPortal_Enabled=true
# ReportPortal_Server_Url=http://localhost:8080
# ReportPortal_Server_Project=default_personal
# ReportPortal_Server_Authentication_Uuid=<API key from the Report Portal user profile>
